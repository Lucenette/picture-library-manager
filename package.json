{
  "name": "picture-library-manager",
  "version": "1.1.1",
  "private": true,
  "description": "角色图库管理器",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "icon": "electron-icon-builder --input=src/static/icon.png --output=dist",
    "build": "yarn icon && electron-vite build && electron-builder --publish never",
    "build:win": "yarn build --win",
    "build:mac": "yarn build --mac",
    "build:linux": "yarn build --linux",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "bench": "vitest run --config vitest.bench.config.ts",
    "test": "vitest run --config vitest.main.config.ts && vitest run --config vitest.renderer.config.ts",
    "test:main": "vitest run --config vitest.main.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts"
  },
  "keywords": [],
  "author": "Lucenette",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "element-plus": "^2.9.0",
    "image-size": "^2.0.4",
    "log4js": "^6.9.1",
    "monaco-editor": "^0.57.0",
    "pinyin-pro": "^3.29.4",
    "sharp": "^0.35.4",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^25.0.0",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.1.10"
  }
}
