{
  "name": "picture-library-manager",
  "version": "1.0.1",
  "private": true,
  "description": "角色图库管理器",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "icon": "electron-icon-builder --input=src/static/icon.png --output=dist",
    "build": "yarn icon && electron-vite build && electron-builder",
    "build:win": "yarn build --win",
    "build:mac": "yarn build --mac",
    "build:linux": "yarn build --linux",
    "typecheck": "tsc -p tsconfig.node.json && vue-tsc -p tsconfig.web.json"
  },
  "keywords": [],
  "author": "Lucenette",
  "license": "MIT",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "element-plus": "^2.9.0",
    "image-size": "^1.2.0",
    "sharp": "^0.35.4",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "electron": "^40.0.0",
    "electron-builder": "^25.0.0",
    "electron-icon-builder": "^2.0.1",
    "electron-vite": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vue-tsc": "^2.1.10"
  }
}
