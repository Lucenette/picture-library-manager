# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 的行尾空格有语义（强制换行）
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

# 内置默认脚本沿用 4 空格缩进，与用户自行编写的脚本风格一致
[src/static/default-script.js]
indent_size = 4
